# ----------------------------------------------------------------- tracing --
# TRACE 'x'  -- emit one byte to stderr at runtime (crash bisection).
# Saves every register the trace helper could disturb.
.macro TRACE ch
    push rax
    push rcx
    push rdx
    push rsi
    push rdi
    push r8
    push r9
    push r10
    push r11
    mov edi, \ch
    call dbg_mark
    pop r11
    pop r10
    pop r9
    pop r8
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    pop rax
.endm

# TRACE_RSP -- print the current stack pointer (hex) to stderr
.macro TRACE_RSP
    push rdi
    mov rdi, rsp
    call dbg_hex
    pop rdi
.endm
